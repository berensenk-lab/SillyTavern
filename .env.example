# Environment Configuration Example
# 
# Copy this file to .env and fill in your values (if needed)
# Most settings are already configured in docker-compose.yml
#
# For SillyTavern + Ollama stack, the main settings are:

# Node environment (production or development)
NODE_ENV=production

# Ollama API URL (used by containers on the network)
# From host machine, use: http://localhost:11434
# From inside Docker containers, use: http://ollama:11434
OLLAMA_API_URL=http://ollama:11434

# Ollama host binding (listen on all interfaces)
OLLAMA_HOST=0.0.0.0:11434

# Optional: GPU configuration for Ollama
# Uncomment if you have an NVIDIA GPU:
# CUDA_VISIBLE_DEVICES=0

# Optional: Memory limits (in bytes or with units like 10g, 512m)
# Uncomment if your system needs limits:
# SILLYTAVERN_MEMORY_LIMIT=4g
# OLLAMA_MEMORY_LIMIT=10g
